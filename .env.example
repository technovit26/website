# One key, or many separated by commas / newlines.
# Also picked up: GEMINI_API_KEY, GEMINI_API_KEY_1, GEMINI_API_KEY_2, ...
# Google applies quota PER PROJECT, not per key — keys from the same
# project share one pool and add no throughput.
GEMINI_API_KEYS=your-key-here

# ── Model ────────────────────────────────────────────────────────────
# Exactly one GEMINI_MODEL line uncommented. If two are live the LAST
# one wins, which is easy to do by accident — check before you blame
# the model. Restart `pnpm dev` after changing.

# Accurate. Gets date and price filters right. Default. ~9-14s a reply.
GEMINI_MODEL=gemini-3.5-flash

# Faster and cheaper, but INVENTS events on date/price questions.
# Verified: asked what is free on 31 Aug it named an event from 28 Aug.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Newer, higher quota cost. Try if 3.5-flash is too slow.
# GEMINI_MODEL=gemini-3.7-flash
# GEMINI_MODEL=gemini-3.6-flash

# Older, still available.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash-lite

# Always the current Flash. Never 404s on retirement, but Google can
# change what it points at without warning — avoid during the fest.
# GEMINI_MODEL=gemini-flash-latest
